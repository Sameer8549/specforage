SPECFORGE_ENV=development
# Optional deployment override; otherwise the current directory is used when it contains data/.
# SPECFORGE_DATA_ROOT=/app
# Comma-separated frontend origins. Set the deployed frontend URL in Railway.
SPECFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SPECFORGE_WORKING_DATASET=data/sample_1000_items.csv
SPECFORGE_GROUND_TRUTH_DATASET=data/ground_truth.csv
# Mount /data as persistent storage in production before enabling this path.
# SPECFORGE_MANUFACTURER_CACHE_PATH=/data/manufacturer_lookup.json
SPECFORGE_EXPECTED_WORKING_ROWS=1000
# The supplied file currently contains 2 rows. Set to 200 when the full ground truth is provided.
SPECFORGE_EXPECTED_GROUND_TRUTH_ROWS=2
SPECFORGE_UNSPSC_DATASET=data/unspsc_codes.csv
SPECFORGE_UNSPSC_EMBEDDINGS=data/unspsc_bge_small.float16.npy
SPECFORGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPECFORGE_CLASSIFICATION_THRESHOLD=0.42
SPECFORGE_CLASSIFICATION_TIE_MARGIN=0.03
SPECFORGE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SPECFORGE_NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Required locally: NVIDIA_API_KEY
SPECFORGE_ADJUDICATION_REASONING_BUDGET=16384
SPECFORGE_GROQ_BASE_URL=https://api.groq.com/openai/v1
SPECFORGE_GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback locally: GROQ_API_KEY
SPECFORGE_LLM_TIMEOUT_SECONDS=30
SPECFORGE_LLM_MAX_RETRIES=2
SPECFORGE_LLM_RETRY_BACKOFF_SECONDS=0.5
SPECFORGE_ATTRIBUTE_MATCH_THRESHOLD=0.90
SPECFORGE_VERIFICATION_CONFIDENCE_THRESHOLD=0.80
